# ==== Banco de dados (Vercel Postgres / Neon) ====
# Na Vercel (Storage > Postgres) estas variáveis são criadas AUTOMATICAMENTE.
# Localmente, copie os valores do painel da Vercel (Settings > Environment Variables).
#  - POSTGRES_PRISMA_URL   -> conexão com pooler, própria para o Prisma
#  - DATABASE_URL_UNPOOLED -> conexão direta (migrações / db push)
POSTGRES_PRISMA_URL="postgres://usuario:senha@host-pooler.regiao.aws.neon.tech/db?sslmode=require&pgbouncer=true&connect_timeout=15"
DATABASE_URL_UNPOOLED="postgres://usuario:senha@host.regiao.aws.neon.tech/db?sslmode=require"

# ==== Segredo da sessão (JWT) ====
# Gere um valor aleatório forte, ex.:  openssl rand -base64 48
SESSION_SECRET="troque-por-um-valor-aleatorio-bem-grande"

# ==== E-mail (Resend) para recuperação de senha ====
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
# Remetente verificado no Resend (ou onboarding@resend.dev para testes):
EMAIL_FROM="Ponto <onboarding@resend.dev>"

# ==== URL pública do app (para montar o link do e-mail) ====
# Em produção use o domínio da Vercel, ex.: https://seu-app.vercel.app
APP_URL="http://localhost:3000"

# ==== Conta inicial do gerente (usada pelo comando de seed) ====
SEED_MANAGER_NAME="Gerente"
SEED_MANAGER_USERNAME="gerente"
SEED_MANAGER_EMAIL="gerente@empresa.com"
SEED_MANAGER_PASSWORD="troque-esta-senha"
