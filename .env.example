# ==== Banco de dados (Postgres próprio, ex.: container no servidor) ====
DATABASE_URL="postgresql://usuario:senha@host:5432/banco_de_horas?sslmode=disable"

# ==== Segredo da sessão (JWT) ====
# Gere um valor aleatório forte, ex.:  openssl rand -base64 48
SESSION_SECRET="troque-por-um-valor-aleatorio-bem-grande"

# ==== E-mail (Resend) para recuperação de senha ====
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
# Remetente verificado no Resend (ou onboarding@resend.dev para testes):
EMAIL_FROM="Ponto <onboarding@resend.dev>"

# ==== URL pública do app (para montar o link do e-mail) ====
APP_URL="https://bancodehoras.grupox4growth.com"

# ==== Notificações push (app fechado) ====
# A chave pública fica no código (src/lib/vapid.ts). Só a PRIVADA é segredo:
VAPID_PRIVATE="cole-aqui-a-chave-privada-vapid"
# Segredo que protege o endpoint do agendador (/api/cron/alerts). Gere um aleatório:
CRON_SECRET="troque-por-um-valor-aleatorio"

# ==== Conta inicial do gerente (usada pelo comando de seed) ====
SEED_MANAGER_NAME="Gerente"
SEED_MANAGER_USERNAME="gerente"
SEED_MANAGER_EMAIL="gerente@empresa.com"
SEED_MANAGER_PASSWORD="troque-esta-senha"
